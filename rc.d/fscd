#!/bin/sh
#
# $Id: fscd 1943 2012-05-07 18:16:26Z bsdtrhodes $
#
# Start up for service monitoring daemon.
#

# PROVIDE: fscd
# REQUIRE: DAEMON syslogd
# BEFORE:  LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="fscd"
fscd_startflags="-d"
fscd_stopflags="shutdown"
fscadm_command="/usr/local/bin/fscadm"
rcvar="fscd_enable"
load_rc_config $name
: ${fscd_enable="NO"}

command="/usr/local/sbin/${name}"
pidfile="/var/run/${name}.pid"
required_files="/usr/local/etc/$name.conf"

start_cmd=fscd_start
stop_cmd=fscd_stop

fscd_start()
{
	${command} ${fscd_startflags}
}

fscd_stop()
{
	${fscadm_command} ${fscd_stopflags}
}

run_rc_command "$1"
